---
import Base from '../layouts/Base.astro';
import BotButton from '../components/BotButton.astro';
import SectionHead from '../components/SectionHead.astro';
import ReportFragment from '../components/ReportFragment.astro';
import Products from '../components/Products.astro';
import Plans from '../components/Plans.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Txt from '../components/Txt.astro';
import { company, faq, firstClients, partners, getProduct, productPrice, rub, isPlaceholder } from '../data/site';
import { allServices, faqPage } from '../lib/schema';

const audit = getProduct('audit');
const checkup = getProduct('checkup');
const order = getProduct('order');
const minPlan = 35000;

const pains = [
  { tag: 'сбой', title: 'Сайт упал в день распродажи', text: 'Реклама оплачена, покупатели пришли, а страница не открывается. О сбое вы узнали от клиента в чате.' },
  { tag: 'доступы', title: 'Пароли — у фрилансера, который не отвечает', text: 'Сервер настраивал человек, с которым вы больше не работаете. Где доступы и что он там настроил, знает только он.' },
  { tag: 'копии', title: 'Копии «вроде есть»', text: 'Хостинг что-то сохраняет. Восстановить из этого сайт и базу заказов никто ни разу не пробовал.' },
  { tag: 'обновления', title: 'Обновления — ночью и со страхом', text: 'Каждый выпуск — ночная смена разработчика. Если что-то сломалось, быстро вернуть как было не получится.' },
];

const steps = [
  { n: '01', title: 'Проверка за 5 дней', text: `Смотрим серверы, копии, доступы и запас по нагрузке. Отдаём отчёт: что в порядке, что опасно, что сделать первым.`, price: `${rub(checkup.price)} или ${rub(audit.price)}` },
  { n: '02', title: 'Наводим порядок', text: 'Настраиваем копии с проверкой восстановления, сигнализацию о сбоях, спокойный выпуск обновлений. Всё описываем в документации.', price: `${order.term}, ${productPrice(order)}` },
  { n: '03', title: 'Следим каждый месяц', text: 'Сигнализация работает круглосуточно, копии проверяем каждый месяц, на ваши задачи есть часы инженера. Раз в месяц — отчёт.', price: `от ${rub(minPlan)} в месяц` },
];

const reportItems = [
  ['Карта хозяйства', 'Какие серверы, где стоят, кто и как к ним подключается.'],
  ['Риски по приоритетам', 'Высокий, средний, низкий — и простыми словами, чем грозит каждый.'],
  ['Запасные копии', 'Есть ли они, где лежат и можно ли из них реально восстановиться.'],
  ['Запас по нагрузке', 'Выдержит ли сайт распродажу или рекламную кампанию.'],
  ['Незапертые двери', 'Старые версии, открытые порты и лишние доступы, через которые можно унести базу клиентов.'],
  ['План работ с оценкой в часах', 'Его можно отдать нам, своему разработчику или любому подрядчику.'],
];

const trust = [
  { title: 'Всё записываем и отдаём вам', text: 'Схема серверов, доступы, инструкции по восстановлению. Вы не привязаны к нам и не зависите от памяти одного человека.' },
  { title: 'Договор, где всё записано', text: 'Состав работ, сроки реакции, компенсация за их нарушение на тарифе «Бизнес» и предел нашей ответственности.' },
  { title: 'Соглашение о конфиденциальности — до начала работ', text: 'Подписываем его раньше, чем получаем первый доступ к вашему серверу.' },
  { title: 'Доступы — через менеджер паролей', text: 'Не в чате и не в почте. У каждого инженера своя учётная запись: вы отключаете её в любой момент.' },
];
---
<Base
  title="RootLab — DevOps на аутсорс: аудит, копии, мониторинг серверов | Екатеринбург"
  description="Инженеры для сайтов и онлайн-сервисов без своего DevOps. Аудит инфраструктуры за 5 дней — 30 000 ₽, техосмотр сайта — 12 000 ₽, сопровождение серверов от 35 000 ₽ в месяц. Работаем по всей России."
  schema={[...allServices(), faqPage(faq)]}
>
  <!-- 1. Первый экран -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Команда инженеров · {company.city} · по всей России</p>
        <h1 id="hero-title">За пять дней покажем, что может уронить ваш сайт</h1>
        <p class="hero__sub">Потом наведём порядок и будем за ним следить. Для сайтов и сервисов, которым рано нанимать своего DevOps.</p>
        <div class="hero__cta">
          <BotButton tag="hero">Заказать аудит за {rub(audit.price)}</BotButton>
          <BotButton tag="heroQuestion" variant="ghost">Задать вопрос инженеру</BotButton>
        </div>
        <p class="hero__alt small">Небольшой магазин или онлайн-школа? <BotButton tag="heroCheckup" variant="link">Техосмотр — {rub(checkup.price)}</BotButton></p>
        <ul class="hero__facts mono" aria-label="Коротко об условиях">
          <li><b>5</b> рабочих дней</li>
          <li><b>фикс</b> цена первого шага</li>
          <li><b>0</b> годовых договоров</li>
        </ul>
      </div>
      <div class="hero__visual">
        <ReportFragment />
      </div>
    </div>
  </section>

  <!-- 2. Узнаёте себя -->
  <section class="section" aria-labelledby="pains-title">
    <div class="container">
      <SectionHead num="01" eyebrow="Знакомые ситуации" title="Узнаёте себя?" id="pains-title" />
      <div class="grid grid--4">
        {pains.map((p) => (
          <article class="card pain">
            <p class="pain__tag mono">{p.tag}</p>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </article>
        ))}
      </div>
      <p class="pains__after">Если хоть одно — про вас, начните с проверки. Это 5 рабочих дней и фиксированная цена. <a href="#pricing" class="link-arrow">Смотреть цены</a></p>
    </div>
  </section>

  <!-- 3. Как это работает -->
  <section class="section section--tint" aria-labelledby="how-title">
    <div class="container">
      <SectionHead num="02" eyebrow="Как это работает" title="Три шага. На любом можно остановиться" id="how-title">
        Отчёт и документация остаются у вас, даже если дальше вы пойдёте без нас.
      </SectionHead>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step__n mono" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
            <p class="step__price mono">{s.price}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Что вы получите после аудита -->
  <section class="section" aria-labelledby="report-title">
    <div class="container split">
      <div>
        <SectionHead num="03" eyebrow="Результат проверки" title="Что вы получите после аудита" id="report-title">
          Документ, который понятен и владельцу, и разработчику. Для техосмотра — две страницы простым языком.
        </SectionHead>
        <dl class="rlist">
          {reportItems.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
          <div><dt>Часовой созвон с техническим директором</dt><dd>Разберём отчёт вместе и ответим на вопросы. Входит в экспресс-аудит.</dd></div>
        </dl>
        <p class="rlist__more"><a href="/audit/" class="link-arrow">Подробнее об аудите и техосмотре</a></p>
      </div>
      <div class="sample">
        <div class="sample__pages" aria-hidden="true">
          <div class="sample__page sample__page--back"></div>
          <div class="sample__page">
            <p class="mono sample__k">RootLab · отчёт</p>
            <p class="sample__title">Экспресс-аудит инфраструктуры</p>
            <p class="mono sample__k">Проект: ●●●●●●●.ru · 5 рабочих дней</p>
            <div class="sample__bars">
              <span style="--w:92%"></span><span style="--w:78%"></span><span style="--w:85%"></span>
              <span style="--w:60%"></span><span style="--w:88%"></span><span style="--w:40%"></span>
            </div>
            <div class="sample__sum mono">
              <span><b class="hi">2</b> высоких</span><span><b class="mid">4</b> средних</span><span><b class="ok">7</b> в порядке</span>
            </div>
          </div>
        </div>
        <p class="small"><mark class="ph">[образец отчёта — заглушка: заменить на обезличенный PDF]</mark></p>
      </div>
    </div>
  </section>

  <!-- 5. Тарифы и цены -->
  <section class="section section--tint" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <SectionHead num="04" eyebrow="Цены" title="Цены и сроки — открыто" id="pricing-title">
        Начинаете с разовой проверки. Риск — {rub(checkup.price)} или {rub(audit.price)}, а не годовой договор.
      </SectionHead>
      <Products />

      <div class="pricing__sub">
        <h3 class="pricing__h3">Ежемесячное сопровождение</h3>
        <p class="muted">Следим за серверами, проверяем копии и делаем ваши задачи. Договор помесячный.</p>
      </div>
      <Plans />

      <aside class="offer" aria-labelledby="offer-title">
        <p class="mono offer__tag">Первым {firstClients.slots} клиентам</p>
        <div>
          <h3 id="offer-title">−{firstClients.discount}% на первые {firstClients.months} месяца сопровождения</h3>
          <p>Взамен просим разрешить опубликовать кейс и ваш отзыв. Мы только начинаем и честно об этом говорим.</p>
        </div>
        <BotButton tag="firstClients">Занять место</BotButton>
      </aside>
    </div>
  </section>

  <!-- 6. Команда -->
  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <SectionHead num="05" eyebrow="Команда RootLab" title="Кто будет работать с вашим сервером" id="team-title">
        Кейсов у нас пока нет — мы только открылись. Поэтому аудит проводит сам технический директор, а цена первого шага фиксирована.
      </SectionHead>
      <Team />
      <p class="team__q"><BotButton tag="team" variant="link">Задать вопрос Виктору Вайнеру</BotButton></p>
    </div>
  </section>

  <!-- 7. Доверие -->
  <section class="section section--tint" aria-labelledby="trust-title">
    <div class="container">
      <SectionHead num="06" eyebrow="Доверие" title="Почему нам можно доверить сервер" id="trust-title" />
      <div class="grid grid--2 trust">
        {trust.map((t, i) => (
          <div class="trust__item">
            <span class="mono trust__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{t.title}</h3><p class="muted">{t.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Для веб-студий -->
  <section class="section" aria-labelledby="studio-title">
    <div class="container">
      <div class="studio">
        <div>
          <p class="eyebrow"><b>07</b> / Веб-студиям</p>
          <h2 id="studio-title">Вы делаете сайты. Серверы — на нас</h2>
        </div>
        <ul class="ticks">
          <li>Клиент звонит «сайт лежит» — чиним мы, ваш разработчик остаётся в проекте.</li>
          <li>Работаем под именем студии: клиент остаётся вашим.</li>
          <li>Не переманиваем клиентов и не предлагаем им разработку.</li>
          <li>{partners.revenueShare}% от платежей приведённого клиента за первые {partners.revenueShareMonths} месяцев — или скидка {partners.whiteLabelDiscount}% при работе под вашим именем.</li>
        </ul>
        <a href="/partners/" class="link-arrow">Условия для студий</a>
      </div>
    </div>
  </section>

  <!-- 9. Частые вопросы -->
  <section class="section section--tint" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead num="08" eyebrow="Вопросы" title="Частые вопросы" id="faq-title" />
      <Faq items={faq} />
    </div>
  </section>

  <!-- 10. Финальный призыв -->
  <section class="section final" id="contact" aria-labelledby="final-title">
    <div class="container final__grid">
      <div class="final__text">
        <p class="eyebrow"><b>09</b> / Начать</p>
        <h2 id="final-title">Начните с проверки</h2>
        <p class="final__lead">5 рабочих дней, фиксированная цена, отчёт остаётся у вас.</p>
        <div class="hero__cta">
          <BotButton tag="final">Заказать аудит за {rub(audit.price)}</BotButton>
          <BotButton tag="finalCheckup" variant="ghost">Техосмотр за {rub(checkup.price)}</BotButton>
        </div>
        <dl class="contacts mono">
          <div><dt>Почта</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div><dt>Телефон</dt><dd>{isPlaceholder(company.phone) ? <Txt text={company.phone} /> : <a href={`tel:${company.phone.replace(/[^\d+]/g, '')}`}>{company.phone}</a>}</dd></div>
          <div><dt>Город</dt><dd>{company.city}, работаем удалённо</dd></div>
        </dl>
      </div>
      <div class="card final__form">
        <h3>Или оставьте заявку</h3>
        <p class="muted small">Перезвоним или напишем, уточним задачу и скажем, с чего начать.</p>
        <LeadForm source="home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Первый экран */
  .hero { padding: 28px 0 var(--section); }
  .hero__grid { display: grid; gap: 40px; }
  .hero__text { display: grid; gap: 18px; align-content: start; }
  .hero__sub { font-size: 1.125rem; color: var(--ink-2); max-width: 560px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero__alt { color: var(--ink-2); }
  .hero__facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; padding-top: 18px; border-top: 1px solid var(--line); font-size: .8125rem; color: var(--ink-3); }
  .hero__facts b { color: var(--ink); font-weight: 400; }
  @media (max-width: 420px) {
    .hero__cta :global(.btn) { width: 100%; }
    .hero h1 { font-size: 1.95rem; }
  }
  @media (min-width: 1024px) {
    .hero { padding: 72px 0 96px; }
    .hero__grid { grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center; }
  }

  /* Боли */
  .pain { display: grid; gap: 10px; align-content: start; }
  .pain__tag { font-size: .75rem; color: var(--accent-ink); }
  .pain__tag::before { content: '# '; color: var(--ink-3); }
  .pains__after { margin-top: 32px; font-size: 1.125rem; }

  /* Шаги */
  .steps { list-style: none; display: grid; gap: 0; counter-reset: s; }
  .step { position: relative; display: grid; gap: 10px; padding: 0 0 36px 52px; }
  .step::before { content: ''; position: absolute; left: 15px; top: 34px; bottom: 0; width: 1px; background: var(--line-strong); }
  .step:last-child::before { display: none; }
  .step__n { position: absolute; left: 0; top: 0; width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--accent); color: var(--accent); border-radius: 50%; font-size: .8125rem; background: var(--surface); }
  .step__price { font-size: .875rem; color: var(--ink); }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .step { padding: 56px 0 0; }
    .step::before { left: 40px; right: -32px; top: 16px; bottom: auto; width: auto; height: 1px; }
  }

  /* Отчёт */
  .split { display: grid; gap: 48px; }
  @media (min-width: 1024px) { .split { grid-template-columns: 1.2fr 1fr; gap: 72px; align-items: start; } }
  .rlist { margin: 0; display: grid; }
  .rlist div { display: grid; gap: 4px; padding: 14px 0; border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .rlist div { grid-template-columns: 220px 1fr; gap: 24px; } }
  .rlist dt { font-weight: 600; }
  .rlist dd { margin: 0; color: var(--ink-2); }
  .rlist__more { margin-top: 24px; }
  .sample { display: grid; gap: 14px; }
  @media (min-width: 1024px) { .sample { position: sticky; top: calc(var(--header-h) + 32px); } }
  .sample__pages { position: relative; padding: 0 18px 18px 0; }
  .sample__page { position: relative; aspect-ratio: 1 / 1.3; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 4px; padding: 9% 9%; display: grid; align-content: start; gap: 10px; box-shadow: 0 18px 40px -26px rgba(29,32,36,.35); }
  .sample__page--back { position: absolute; inset: 18px 0 0 18px; transform: rotate(2deg); box-shadow: none; }
  .sample__k { font-size: .6875rem; color: var(--ink-3); }
  .sample__title { font-weight: 600; font-size: 1.25rem; line-height: 1.2; margin: 6px 0 4px; }
  .sample__bars { display: grid; gap: 9px; margin: 14px 0; }
  .sample__bars span { height: 7px; width: var(--w); background: var(--surface-2); border-radius: 2px; }
  .sample__sum { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .75rem; color: var(--ink-2); padding-top: 12px; border-top: 1px dashed var(--line); }
  .sample__sum b { font-weight: 400; font-size: 1.25rem; margin-right: 4px; }
  .hi { color: var(--risk-high); } .mid { color: var(--risk-mid); } .ok { color: var(--risk-ok); }

  /* Цены */
  .pricing__sub { margin: 64px 0 24px; display: grid; gap: 6px; }
  .pricing__h3 { font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem); }
  .offer { margin-top: 40px; display: grid; gap: 16px; padding: 24px; border: 1px solid var(--ink); border-radius: var(--radius-lg); background: var(--bg); }
  .offer h3 { font-size: 1.35rem; margin-bottom: 6px; }
  .offer__tag { font-size: .75rem; color: var(--accent-ink); text-transform: uppercase; letter-spacing: .04em; }
  @media (min-width: 900px) { .offer { grid-template-columns: 180px 1fr auto; align-items: center; gap: 32px; padding: 28px 32px; } }

  .team__q { margin-top: 28px; }

  /* Доверие */
  .trust { gap: 0 48px; }
  .trust__item { display: grid; grid-template-columns: 40px 1fr; gap: 12px; padding: 24px 0; border-top: 1px solid var(--line); }
  .trust__item h3 { margin-bottom: 6px; }
  .trust__n { color: var(--accent); font-size: .875rem; padding-top: 3px; }

  /* Студии */
  .studio { display: grid; gap: 24px; padding: 28px; border-radius: var(--radius-lg); background: var(--ink); color: #f1f1ec; }
  .studio h2 { margin-top: 10px; }
  .studio .eyebrow { color: #a9adb3; }
  .studio .eyebrow b { color: #9db0ff; }
  .studio .ticks li::before { color: #9db0ff; }
  .studio .link-arrow { color: #fff; justify-self: start; }
  .studio .link-arrow:focus-visible { outline-color: #9db0ff; }
  @media (min-width: 1024px) { .studio { grid-template-columns: 1fr 1.2fr; padding: 48px; gap: 24px 64px; } .studio .link-arrow { grid-column: 2; } }

  /* Финал */
  .final__grid { display: grid; gap: 40px; }
  .final__text { display: grid; gap: 18px; align-content: start; }
  .final__lead { font-size: 1.125rem; color: var(--ink-2); }
  .final__form { display: grid; gap: 8px; }
  .final__form h3 { font-size: 1.25rem; }
  .final__form :global(form) { margin-top: 12px; }
  .contacts { margin: 12px 0 0; display: grid; gap: 10px; font-size: .875rem; }
  .contacts div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; }
  .contacts dt { color: var(--ink-3); }
  .contacts dd { margin: 0; }
  @media (min-width: 1024px) { .final__grid { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
</style>
