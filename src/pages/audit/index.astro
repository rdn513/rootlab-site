---
import Base from '../../layouts/Base.astro';
import '../../styles/page.css';
import PageHead from '../../components/PageHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import BotButton from '../../components/BotButton.astro';
import ReportFragment from '../../components/ReportFragment.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProduct, productPrice, rub } from '../../data/site';
import { productService, faqPage, breadcrumbs } from '../../lib/schema';

const audit = getProduct('audit');
const checkup = getProduct('checkup');

const scope = [
  ['Серверы и хостинг', 'Где что стоит, версии ОС и ПО, сроки поддержки, конфигурация веб-сервера и базы данных.'],
  ['Резервные копии', 'Что копируется, куда, как часто, сколько хранится. Проверяем, восстанавливается ли копия на самом деле.'],
  ['Доступы', 'Кто и как подключается к серверам, панелям, хостингу, DNS, репозиторию. Чьи доступы пора закрыть.'],
  ['Мониторинг', 'Кто и как узнаёт о сбое. Если сигнализации нет — какой нужна.'],
  ['Запас по нагрузке', 'Процессор, память, диск, база данных. Сколько выдержит сайт при росте трафика в 2–3 раза.'],
  ['Проверка настроек', 'Открытые порты, устаревшие версии с известными уязвимостями, пароли по умолчанию, лишние сервисы.'],
  ['Выпуск обновлений', 'Как код попадает на сервер, можно ли быстро откатиться, где хранятся секреты.'],
];

const process = [
  ['День 0 — договор и NDA', 'Подписываем договор и соглашение о конфиденциальности. Порядок оплаты — [условия оплаты — уточнить].'],
  ['День 1 — доступы', 'Вы передаёте доступы через менеджер паролей. Если не знаете, где какие доступы, — поможем составить список.'],
  ['Дни 1–4 — проверка', 'Только смотрим и ничего не меняем на рабочих серверах без вашего согласия.'],
  ['День 5 — отчёт', 'Присылаем отчёт. Для аудита — часовой созвон с Виктором Вайнером, техническим директором: разбираем риски и план.'],
];

const auditFaq = [
  { q: 'Вы что-то поменяете на сервере во время аудита?', a: 'Нет. Аудит — это только чтение. Если найдём что-то срочное, например открытую базу данных, сразу сообщим и предложим исправить, но без вашего согласия ничего не трогаем.' },
  { q: 'Что нужно от нас?', a: 'Доступы к серверам и хостингу, 30 минут на вводный созвон и контакт человека, который ответит на вопросы о проекте. Если такого человека нет — тоже нормально.' },
  { q: 'Чем техосмотр отличается от аудита?', a: `Техосмотр (${rub(checkup.price)}) — для владельца небольшого сайта: две страницы простым языком. Аудит (${rub(audit.price)}) — для студий и команд: подробный отчёт, план работ в часах и созвон с техдиректором.` },
  { q: 'Аудит правда засчитывается в работы?', a: `Да. Если после аудита вы заказываете у нас проект «Порядок» или сопровождение, ${rub(audit.price)} вычитаем из стоимости.` },
];
---
<Base
  title="Аудит IT-инфраструктуры за 5 дней — 30 000 ₽ | RootLab"
  description="Экспресс-аудит серверов и инфраструктуры сайта: риски по приоритетам, план работ в часах, созвон с техдиректором. 5 рабочих дней, 30 000 ₽. Техосмотр для небольших сайтов — 12 000 ₽."
  schema={[productService(audit), productService(checkup), faqPage(auditFaq), breadcrumbs([{ name: 'Аудит', path: '/audit/' }])]}
>
  <PageHead crumb="Аудит и техосмотр" eyebrow="Первый шаг · 5 рабочих дней" title="Аудит IT-инфраструктуры: что может упасть и что делать первым">
    <p>Фиксированная цена и срок. Вы рискуете {rub(checkup.price)} или {rub(audit.price)}, а получаете понятную картину и план, который можно отдать любому подрядчику.</p>
    <Fragment slot="cta">
      <BotButton tag="auditPage">Заказать аудит за {rub(audit.price)}</BotButton>
      <BotButton tag="auditPageCheckup" variant="ghost">Техосмотр за {rub(checkup.price)}</BotButton>
    </Fragment>
  </PageHead>

  <section class="section" aria-labelledby="two-title">
    <div class="container">
      <SectionHead eyebrow="Два формата" title="Выберите формат" id="two-title" />
      <div class="grid grid--2">
        <article class="pricebox" id="checkup">
          <p class="eyebrow">Для собственников</p>
          <h3>{checkup.name}</h3>
          <p class="pricebox__sum">{productPrice(checkup)}</p>
          <p class="pricebox__meta">Срок: {checkup.term}</p>
          <p class="muted">Для интернет-магазина, онлайн-школы, сервиса записи. Без терминов: что в порядке, что опасно, что сделать первым.</p>
          <ul class="ticks small">{checkup.includes.map((i) => <li>{i}</li>)}</ul>
          <div><BotButton tag="auditCardCheckup" variant="ghost">Заказать техосмотр</BotButton></div>
        </article>
        <article class="pricebox" id="audit">
          <p class="eyebrow">Для студий и продуктовых команд</p>
          <h3>{audit.name}</h3>
          <p class="pricebox__sum">{productPrice(audit)}</p>
          <p class="pricebox__meta">Срок: {audit.term} · {audit.priceNote}</p>
          <p class="muted">Полный разбор инфраструктуры с техническими подробностями и оценкой работ.</p>
          <ul class="ticks small">{audit.includes.map((i) => <li>{i}</li>)}</ul>
          <div><BotButton tag="auditCardAudit">Заказать аудит</BotButton></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="scope-title">
    <div class="container two">
      <div>
        <SectionHead eyebrow="Что проверяем" title="Семь областей, которые чаще всего роняют сайт" id="scope-title" />
        <dl class="kv">{scope.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
      </div>
      <div>
        <ReportFragment />
        <p class="small" style="margin-top:14px"><mark class="ph">[образец отчёта — заглушка: заменить на обезличенный PDF и дать ссылку на скачивание]</mark></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proc-title">
    <div class="container">
      <SectionHead eyebrow="Как проходит" title="Пять рабочих дней по шагам" id="proc-title" />
      <ol class="numlist" style="max-width:820px">
        {process.map(([t, d]) => (<li><h3>{t}</h3><p set:html={d.replace(/(\[[^\]]+\])/g, '<mark class="ph">$1</mark>')} /></li>))}
      </ol>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="afaq-title">
    <div class="container">
      <SectionHead eyebrow="Вопросы" title="Частые вопросы об аудите" id="afaq-title" />
      <Faq items={auditFaq} />
    </div>
  </section>

  <CtaBand title="Начнём с проверки" tag="auditPageBottom" label={`Заказать аудит за ${rub(audit.price)}`} source="audit">
    <p>Напишите в Telegram — уточним, что за проект, и пришлём договор.</p>
  </CtaBand>
</Base>
