---
import Logo from './Logo.astro';
import Txt from './Txt.astro';
import { company, social, footerNav, isPlaceholder } from '../data/site';
const phoneHref = isPlaceholder(company.phone) ? null : `tel:${company.phone.replace(/[^\d+]/g, '')}`;
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__about">
      <Logo />
      <p class="muted small">Инженеры для сайтов и онлайн-сервисов, которым рано нанимать своего DevOps. {company.city}, работаем удалённо по всей России.</p>
    </div>
    <nav aria-label="Услуги">
      <p class="eyebrow">Услуги</p>
      <ul>{footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div>
      <p class="eyebrow">Контакты</p>
      <ul>
        <li>{phoneHref ? <a href={phoneHref}>{company.phone}</a> : <Txt text={company.phone} />}</li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Реквизиты</p>
      <ul class="small">
        <li><Txt text={company.legal.name} /></li>
        <li>ИНН <Txt text={company.legal.inn} /></li>
        <li>ОГРН <Txt text={company.legal.ogrn} /></li>
        <li>{company.city}</li>
      </ul>
    </div>
  </div>
  <div class="container ftr__bottom">
    <span>{company.copyright}</span>
    <a href="/privacy/">Политика обработки персональных данных</a>
  </div>
</footer>
<style>
  .ftr { border-top: 1px solid var(--line); background: var(--surface); padding: 56px 0 32px; font-size: .9375rem; }
  .ftr__grid { display: grid; gap: 32px; }
  .ftr__about { display: grid; gap: 14px; align-content: start; max-width: 340px; }
  .ftr ul { list-style: none; display: grid; gap: 8px; margin-top: 12px; }
  .ftr a { color: var(--ink); text-decoration: none; }
  .ftr a:hover { color: var(--accent); text-decoration: underline; }
  .ftr__bottom {
    display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line);
    color: var(--ink-3); font-family: var(--mono); font-size: .8125rem;
  }
  .ftr__bottom a { color: var(--ink-3); }
  @media (min-width: 720px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ftr__grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
</style>
