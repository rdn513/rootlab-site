---
interface Props { num?: string; eyebrow: string; title: string; id?: string; }
const { num, eyebrow, title, id } = Astro.props;
---
<div class="section-head">
  <p class="eyebrow">{num && <b>{num}</b>}{num && ' / '}{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {Astro.slots.has('default') && <p><slot /></p>}
</div>
