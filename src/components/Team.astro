---
import Txt from './Txt.astro';
import { team } from '../data/site';
---
<div class="team">
  {team.map((m, i) => (
    <article class:list={['card member', i === 0 && 'member--lead']}>
      <div class="member__photo">
        {m.photo
          ? <img src={m.photo} alt={`${m.name}, ${m.role.toLowerCase()}`} width="320" height="320" loading="lazy" />
          : <span class="mono">[фото — уточнить]</span>}
      </div>
      <div class="member__body">
        <h3><Txt text={m.name} />{m.surname && <> <Txt text={m.surname} /></>}</h3>
        <p class="member__role mono">{m.role}</p>
        {m.areas && <p class="member__areas small">{m.areas.split(' · ').map((a, k) => <span>{k > 0 && '· '}{a}</span>)}</p>}
        <p>{m.text}</p>
        {m.details && <p class="small"><Txt text={m.details} /></p>}
      </div>
    </article>
  ))}
</div>
<style>
  .team { display: grid; gap: 16px; }
  @media (min-width: 720px) { .team { grid-template-columns: repeat(2, 1fr); } }
  .member { display: grid; gap: 18px; align-content: start; }
  @media (min-width: 1024px) { .member { grid-template-columns: 200px 1fr; gap: 28px; } }
  .member__photo {
    aspect-ratio: 1 / 1; max-width: 200px; border-radius: var(--radius);
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgba(29,32,36,.035) 10px 11px),
      var(--surface-2);
    display: grid; place-items: center; text-align: center; padding: 12px;
    border: 1px dashed var(--line-strong);
  }
  .member__photo span { font-size: .75rem; color: var(--ph-ink); background: var(--ph-bg); padding: 2px 6px; border-radius: 3px; }
  .member__photo img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); }
  .member__body { display: grid; gap: 8px; }
  .member__role { font-size: .8125rem; color: var(--accent-ink); }
  .member__areas { color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 0 6px; }
  .member__areas span { white-space: nowrap; }
</style>
