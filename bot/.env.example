# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота @rootlab_help_bot из @BotFather
BOT_TOKEN=

# ID чата команды. Узнать: добавьте бота в чат и напишите там /chatid
TEAM_CHAT_ID=

# Домен для приёма заявок с формы сайта (A-запись → IP этого сервера)
API_DOMAIN=api.root-lab.ru

# Сайты, которым можно отправлять форму (через запятую)
ALLOWED_ORIGINS=https://root-lab.ru,https://www.root-lab.ru,https://rdn513.github.io

# Напоминания тем, кто бросил заявку: первое и второе, в минутах
REMIND_FIRST_MIN=60
REMIND_SECOND_MIN=1440
